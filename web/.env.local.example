# Copy to .env.local and fill in. NEVER put private keys here — all signing is client-side.
# Wallets are injected-only (MetaMask / Rabby via EIP-6963) — no WalletConnect, no projectId needed.

# Public site URL — the origin this build serves from, no trailing slash. Feeds metadataBase,
# canonical links, robots.txt and the sitemap (lib/config/site.ts). Prod sets it from the deploy
# workflow; on Vercel it falls back to the deployment URL; locally it defaults to
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Force the indexing decision instead of inferring it. Unset (the normal case) means: any build on
# Vercel is noindex, the self-hosted prod container is indexable — see next.config.mjs. Set to 1 or 0
# only to override that, e.g. to test the noindex wiring locally (SEO_INDEXABLE=0 npm run build).
# It also gates analytics: a non-indexable build never mounts GTM.
SEO_INDEXABLE=

# Per-chain primary RPC URLs (public on the client). Leave blank to use the public fallbacks
# hardcoded in lib/config/chains.ts. To hide paid keys, route through /app/api/rpc instead
# and set the server-only RPC_URL_* variants (no NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_RPC_URL_1=
NEXT_PUBLIC_RPC_URL_8453=
NEXT_PUBLIC_RPC_URL_42161=
NEXT_PUBLIC_RPC_URL_130=
NEXT_PUBLIC_RPC_URL_1301=

# Unichain Sepolia (1301): server-only RPC, hidden behind /app/api/rpc (chains.ts uses it as the
# primary transport for 1301). Put your QuickNode/Alchemy Unichain Sepolia URL here. If left blank,
# the app falls back to the public https://sepolia.unichain.org endpoint.
#
# REQUIRED for the headless UI test (e2e:ui): the browser wallet shim routes its RPC through this
# same-origin proxy to dodge the public endpoint's cross-origin 403s, so the proxy needs an upstream.
# A single consistent backend (e.g. https://unichain-sepolia.drpc.org) avoids the official
# load-balancer's cross-node nonce disagreement that breaks sequential txs.
RPC_URL_1301=https://unichain-sepolia.drpc.org

# Other server-only RPC proxies (optional; same pattern, hide paid keys per chain).
RPC_URL_1=
RPC_URL_8453=
RPC_URL_42161=
RPC_URL_130=

# DEV-ONLY headless testing: set to an address to replace real wallets with a wagmi `mock` connector
# for that account. Pair with `anvil --fork-url <unichain-sepolia> --auto-impersonate` and point
# NEXT_PUBLIC_RPC_URL_1301 at the anvil RPC — anvil signs for the impersonated address (no key needed).
# Foundry default account #0: 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
NEXT_PUBLIC_DEV_BURNER_ADDRESS=

# E2E self-test (scripts/e2e-autolaunch.ts + e2e/ Playwright). Throwaway keys, Unichain Sepolia (1301)
# ONLY — never reuse a real wallet, never commit .env.local. Generate with `cast wallet new`. Two
# accounts so whitelist flows can be tested (one whitelisted, one not).
TEST_PK_1=
TEST_ADDR_1=
TEST_PK_2=
TEST_ADDR_2=
