# Copy to .env.local and fill in. NEVER put private keys here — all signing is client-side.

# RainbowKit / WalletConnect project id. OPTIONAL — injected wallets (MetaMask/Rabby) work without it;
# set it to enable the WalletConnect modal. Get one at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Per-chain primary RPC URLs (public on the client). Leave blank to use the public fallbacks
# hardcoded in lib/config/chains.ts. To hide paid keys, route through /app/api/rpc instead
# and set the server-only RPC_URL_* variants (no NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_RPC_URL_1=
NEXT_PUBLIC_RPC_URL_8453=
NEXT_PUBLIC_RPC_URL_42161=
NEXT_PUBLIC_RPC_URL_130=
NEXT_PUBLIC_RPC_URL_1301=

# Unichain Sepolia (1301): server-only RPC, hidden behind /app/api/rpc (chains.ts uses it as the
# primary transport for 1301). Put your QuickNode/Alchemy Unichain Sepolia URL here. If left blank,
# the app falls back to the public https://sepolia.unichain.org endpoint.
RPC_URL_1301=

# Other server-only RPC proxies (optional; same pattern, hide paid keys per chain).
RPC_URL_1=
RPC_URL_8453=
RPC_URL_42161=
RPC_URL_130=
