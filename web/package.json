{
  "name": "token-launch-hook-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web3 frontend + live demo for the TokenLaunchHook Uniswap v4 hook (Launch Wizard + Governance Dashboard).",
  "scripts": {
    "prebuild": "tsx scripts/gen-contracts.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "gen:contracts": "tsx scripts/gen-contracts.ts",
    "e2e:autolaunch": "esbuild scripts/e2e-autolaunch.ts --bundle --platform=node --format=cjs --tsconfig=tsconfig.json --outfile=.e2e/out.cjs && set -a && . ./.env.local && set +a && node .e2e/out.cjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.0",
    "@uniswap/permit2-sdk": "^1.4.0",
    "@uniswap/sdk-core": "^5.3.0",
    "@uniswap/v3-sdk": "^3.30.3",
    "@uniswap/v4-sdk": "^1.10.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.17.0",
    "wagmi": "^2.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.28.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18.17"
  }
}
