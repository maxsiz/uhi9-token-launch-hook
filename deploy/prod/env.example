# Copy to /home/devops/unilaunch/.env on the prod host, `chmod 600`. Host-local, never in git and
# never in the CI build — these are read at request time by web/app/api/rpc/route.ts.
#
# All optional: an unset chain makes /api/rpc?chainId=<id> answer 501 and the client falls back to
# the public endpoint from lib/config/chains.ts.

# Unichain Sepolia — the only chain with deployed contracts today.
RPC_URL_1301=

# Other chains, if/when paid endpoints are provisioned.
RPC_URL_1=
RPC_URL_130=
RPC_URL_8453=
RPC_URL_42161=

# DO NOT SET: NEXT_PUBLIC_DEV_BURNER_ADDRESS — dev-only, replaces real wallets with a mock connector.
